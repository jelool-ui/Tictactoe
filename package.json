{
  "name": "tic-tac-duel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Tic Tac Duel — un morpion moderne, rapide et hors ligne pour Android.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:release": "npm run build:prod && cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
